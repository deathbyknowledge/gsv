{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-gateway-dev",
  "main": "src/managed-development.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": []
  },
  "vars": {
    "GSV_ACCOUNT_ORIGIN": "http://localhost:8976"
  },
  "define": {
    "__GSV_RELEASE__": "\"operator-local\""
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md"
      ],
      "fallthrough": true
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": [
        "Kernel"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "Process"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": [
        "AppRunner"
      ],
      "tag": "v3"
    },
    {
      "deleted_classes": [
        "AppRunner"
      ],
      "tag": "v4"
    },
    {
      "new_sqlite_classes": [
        "Conversation"
      ],
      "tag": "v5"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Kernel",
        "name": "KERNEL"
      },
      {
        "class_name": "Process",
        "name": "PROCESS"
      },
      {
        "class_name": "Conversation",
        "name": "CONVERSATION"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "gsv-storage-dev"
    }
  ],
  "assets": {
    "directory": "../../web/dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ]
  },
  "services": [
    {
      "binding": "ACCOUNT_HTTP",
      "service": "gsv-installations-dev"
    },
    {
      "binding": "INSTALLATION_DIRECTORY",
      "service": "gsv-installations-dev"
    },
    {
      "binding": "INSTALLATION_OWNERSHIP",
      "service": "gsv-installations-dev",
      "entrypoint": "InstallationOwnershipEntrypoint",
      "props": {
        "authority": "kernel-owner-link"
      }
    },
    {
      "binding": "INFERENCE_EXECUTION",
      "service": "gsv-inference-public-dev"
    },
    {
      "binding": "RIPGIT",
      "service": "gsv-ripgit-dev"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
