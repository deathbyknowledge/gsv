{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-installations",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GSV_BASE_DOMAIN": "example.com",
    "ENVIRONMENT": "production",
    "GSV_ADMIN_ORIGIN": "https://accounts.example.com",
    "GSV_ADMIN_ACCESS_TEAM_DOMAIN": "",
    "GSV_ADMIN_ACCESS_AUD": "",
    "GSV_OWNER_OIDC_ISSUER": "",
    "GSV_OWNER_OIDC_CLIENT_ID": ""
  },
  "d1_databases": [{
    "binding": "INSTALLATIONS_DB",
    "database_name": "gsv-installations",
    "migrations_dir": "migrations",
    "migrations_table": "installation_migrations"
  }]
}
