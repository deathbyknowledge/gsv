{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gsv-instances",
  "main": "src/index.ts",
  // Page callbacks must stay self-contained when serialized into Chromium.
  "keep_names": false,
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [{ "name": "INSTANCES", "class_name": "InstanceCoordinator" }, { "name": "COMPUTERS", "class_name": "ComputerInstance" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InstanceCoordinator"] }, { "tag": "v2", "new_sqlite_classes": ["ComputerInstance"] }],
  "containers": [{
    "class_name": "ComputerInstance",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./computer/Dockerfile", "build_context": "../.." } },
    "observability": { "logs": { "enabled": false } }
  }],
  "r2_buckets": [{ "binding": "PROFILES", "bucket_name": "gsv-browser-profiles" }],
  "services": [
    { "binding": "INSTALLATION_DIRECTORY", "service": "gsv-installations" },
    { "binding": "INSTANCE_EVENTS", "service": "gsv", "entrypoint": "InstancesGatewayEntrypoint", "props": { "authority": "instance-notifications" } }
  ],
  "vars": { "COMPUTER_LIMITS": { "enabled": false, "concurrentInstances": 0, "periodSeconds": 0, "maxInstanceSeconds": 1800 }, "BROWSER_LIMITS": { "enabled": false, "concurrentInstances": 0, "periodSeconds": 0, "maxInstanceSeconds": 1800, "savedProfiles": 0, "profileStorageBytes": 16777216 } },
  "observability": { "enabled": true }
}
