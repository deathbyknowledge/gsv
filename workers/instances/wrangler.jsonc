{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gsv-instances",
  "main": "src/index.ts",
  // Page callbacks must stay self-contained when serialized into Chromium.
  "keep_names": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [{ "name": "INSTANCES", "class_name": "InstanceCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InstanceCoordinator"] }],
  "r2_buckets": [{ "binding": "PROFILES", "bucket_name": "gsv-browser-profiles" }],
  "services": [
    { "binding": "INSTALLATION_DIRECTORY", "service": "gsv-installations" },
    { "binding": "INSTANCE_EVENTS", "service": "gsv", "entrypoint": "InstancesGatewayEntrypoint", "props": { "authority": "instance-notifications" } }
  ],
  "vars": { "BROWSER_LIMITS": { "enabled": false, "concurrentInstances": 0, "periodSeconds": 0, "maxInstanceSeconds": 1800, "savedProfiles": 0, "profileStorageBytes": 16777216 } },
  "observability": { "enabled": true }
}
