{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "esnext.disposable"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node", "./worker-configuration.d.ts"]
  },
  "include": ["src/**/*"]
}
