{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-channel-discord",
  "main": "src/shared.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DISCORD_GATEWAY",
        "class_name": "DiscordGateway"
      },
      {
        "name": "DISCORD_APPLICATION",
        "class_name": "DiscordApplication"
      },
      {
        "name": "DISCORD_PEER",
        "class_name": "DiscordPeer"
      },
      {
        "name": "DISCORD_PAIRING",
        "class_name": "DiscordPairing"
      },
      {
        "name": "DISCORD_INSTALLATIONS",
        "class_name": "DiscordInstallation"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DiscordGateway"
      ]
    },
    {
      "tag": "v2-shared",
      "new_sqlite_classes": [
        "DiscordApplication",
        "DiscordPeer",
        "DiscordPairing"
      ]
    },
    {
      "tag": "v3-installation-retirement",
      "new_sqlite_classes": [
        "DiscordInstallation"
      ]
    }
  ],
  "services": [
    {
      "binding": "GATEWAY",
      "service": "gsv",
      "entrypoint": "AdapterGatewayEntrypoint",
      "props": {
        "id": "discord",
        "calls": [
          "adapter.inbound",
          "adapter.state.update"
        ]
      }
    },
    {
      "binding": "ACCOUNTS",
      "service": "gsv-installations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
