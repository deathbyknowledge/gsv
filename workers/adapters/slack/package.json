{
  "name": "@gsv/channel-slack",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.managed.jsonc",
    "deploy": "wrangler deploy --config wrangler.managed.jsonc --minify",
    "deploy:managed": "wrangler deploy --config wrangler.managed.jsonc --minify",
    "dry-run:managed": "wrangler deploy --config wrangler.managed.jsonc --dry-run --outdir /tmp/gsv-managed-slack-dry-run",
    "test": "vitest run",
    "test:run": "npm run test && npm run test:managed",
    "test:managed": "vitest run --config vitest.managed.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "just-bash": "^3.4.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.123.0"
  }
}
