{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"],
    // multiformats 9 publishes subpath types only through typesVersions, which bundler resolution
    // ignores; without this, @atproto's CID type collapses to an empty interface.
    "paths": { "multiformats/*": ["../../node_modules/multiformats/types/src/*"] }
  },
  "include": ["src/**/*", "test/**/*"]
}
