{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gsv-calls-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "CALL_COORDINATORS", "class_name": "CallCoordinator" }, { "name": "CALLS", "class_name": "PhoneCallObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallCoordinator", "PhoneCallObject"] }],
  "services": [
    { "binding": "INSTALLATION_DIRECTORY", "service": "gsv-installations-dev" },
    { "binding": "REALTIME_SESSIONS", "service": "gsv-inference-public-dev", "entrypoint": "InferenceRealtimeEntrypoint", "props": { "authority": "realtime-sessions" } },
    { "binding": "PHONE_EVENTS", "service": "gsv-gateway-dev", "entrypoint": "PhoneGatewayEntrypoint", "props": { "authority": "phone-notifications" } }
  ],
  // Runs in its own `wrangler dev` beside `npm run dev`. Calls stay off until .dev.vars supplies Twilio credentials, a public tunnel origin,
  // PHONE_LIMITS and PHONE_ROUTES (JSON text); see .dev.vars.example.
  "vars": {
    "PUBLIC_ORIGIN": "https://calls.invalid",
    "PHONE_LIMITS": { "enabled": false, "concurrentCalls": 0, "dailyCalls": 0, "maxCallSeconds": 360 },
    "PHONE_ROUTES": [],
    "PHONE_REALTIME": { "model": "gpt-realtime-2.1", "voice": "marin", "transcriptionModel": "gpt-4o-mini-transcribe" }
  }
}
