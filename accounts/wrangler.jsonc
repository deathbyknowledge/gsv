{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-accounts",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gsv.space/admin*",
      "zone_name": "gsv.space"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "GSV_ACCOUNT_ORIGIN": "https://gsv.space",
    "GSV_BASE_DOMAIN": "gsv.space"
  },
  "secrets": {
    "required": [
      "GSV_ADMIN_ACCESS_TEAM_DOMAIN",
      "GSV_ADMIN_ACCESS_AUD"
    ]
  },
  "d1_databases": [
    {
      "binding": "ACCOUNT_DB",
      "database_name": "gsv-accounts",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
