<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gsv_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/gsv_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_explanation"
            android:textColor="@color/gsv_muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/gatewayUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:autofillHints="url"
            android:hint="@string/gateway_url"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/gsv_text"
            android:textColorHint="@color/gsv_muted" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="username"
            android:hint="@string/username"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:textColor="@color/gsv_text"
            android:textColorHint="@color/gsv_muted" />

        <EditText
            android:id="@+id/deviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/device_id"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:textColor="@color/gsv_text"
            android:textColorHint="@color/gsv_muted" />

        <EditText
            android:id="@+id/deviceToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:hint="@string/device_token"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/gsv_text"
            android:textColorHint="@color/gsv_muted" />

        <Button
            android:id="@+id/saveConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save" />

        <TextView
            android:id="@+id/setupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/gsv_primary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
