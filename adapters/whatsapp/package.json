{
  "name": "gsv-channel-whatsapp",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run test:run",
    "bundle": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260731.1",
    "patch-package": "8.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  }
}
