{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-channel-slack",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SLACK_ACCOUNT",
        "class_name": "SlackAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SlackAccount"]
    }
  ],
  "services": [
    {
      "binding": "GATEWAY",
      "service": "gsv",
      "entrypoint": "AdapterGatewayEntrypoint",
      "props": {
        "id": "slack",
        "calls": ["adapter.inbound", "adapter.state.update"]
      }
    }
  ]
}
