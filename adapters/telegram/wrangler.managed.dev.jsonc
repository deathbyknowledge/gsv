{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-managed-telegram-dev",
  "main": "src/managed.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GSV_ACCOUNT_ORIGIN": "http://localhost:8976"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MANAGED_TELEGRAM_PEER",
        "class_name": "ManagedTelegramPeer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ManagedTelegramPeer"]
    }
  ],
  "services": [
    {
      "binding": "GATEWAY",
      "service": "gsv-managed-gateway-dev",
      "entrypoint": "GatewayEntrypoint"
    }
  ]
}
