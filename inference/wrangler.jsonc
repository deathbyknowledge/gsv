{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-inference",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "MANAGED_INFERENCE_ENABLED": true,
    "MANAGED_INFERENCE_MONTHLY_LIMIT_NANO_USD": 0
  },
  "secrets": {
    "required": ["OPENROUTER_API_KEY"]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["InferenceInstallation"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "InferenceInstallation",
        "name": "INFERENCE_INSTALLATIONS"
      }
    ]
  },
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "gsv-accounts"
    }
  ],
  "observability": {
    "enabled": true
  }
}
