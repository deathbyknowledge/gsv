{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-inference-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MANAGED_INFERENCE_ENABLED": true,
    "MANAGED_INFERENCE_MONTHLY_LIMIT_NANO_USD": 1500000,
    "OPENROUTER_API_KEY": "test-key"
  },
  "migrations": [
    {
      "new_sqlite_classes": ["InferenceInstallation"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "InferenceInstallation",
        "name": "INFERENCE_INSTALLATIONS"
      }
    ]
  },
  "workers_dev": false,
  "preview_urls": false
}
