{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gsv-test-dependencies",
  "main": "dependencies.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INTEGRATION_STATE",
        "class_name": "IntegrationState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IntegrationState"]
    }
  ],
  "services": [
    {
      "binding": "GATEWAY",
      "service": "gsv",
      "entrypoint": "GatewayEntrypoint"
    }
  ]
}
