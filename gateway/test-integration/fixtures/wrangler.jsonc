{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gsv-test-dependencies",
  "main": "dependencies.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INTEGRATION_STATE",
        "class_name": "IntegrationState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IntegrationState"]
    }
  ],
  "services": [
    {
      "binding": "TELEGRAM_GATEWAY",
      "service": "gsv",
      "entrypoint": "AdapterGatewayEntrypoint",
      "props": {
        "id": "telegram",
        "calls": ["adapter.inbound", "adapter.state.update", "adapter.delivery.claim", "adapter.delivery.report"]
      }
    },
    {
      "binding": "DISCORD_GATEWAY",
      "service": "gsv",
      "entrypoint": "AdapterGatewayEntrypoint",
      "props": {
        "id": "discord",
        "calls": ["adapter.inbound", "adapter.state.update", "adapter.delivery.claim", "adapter.delivery.report"]
      }
    }
  ]
}
