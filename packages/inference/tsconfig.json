{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}
