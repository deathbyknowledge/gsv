{
  "name": "@humansandmachines/gsv-worker-runtime",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./inference-transport": {
      "types": "./dist/inference-transport.d.ts",
      "default": "./dist/inference-transport.js"
    },
    "./portable-do": {
      "types": "./dist/portable-do.d.ts",
      "default": "./dist/portable-do.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "node ./scripts/build-js.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "clean": "rm -rf dist",
    "pack:check": "npm run check && node ../../scripts/validate-public-packages.mjs @humansandmachines/gsv-worker-runtime",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@humansandmachines/gsv": "0.0.7",
    "@humansandmachines/gsv-portable-archive": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^5.20260716.1",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
