{
  "name": "gsv-account-service",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "npm --prefix ../web run build:account && wrangler deploy --minify",
    "dev": "npm --prefix ../web run build:account && wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@humansandmachines/gsv": "file:../packages/gsv",
    "@simplewebauthn/server": "13.3.2",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.115.0"
  }
}
