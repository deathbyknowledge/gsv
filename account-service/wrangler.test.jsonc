{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-accounts-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GSV_ACCOUNT_ORIGIN": "https://accounts.gsv.space",
    "GSV_BASE_DOMAIN": "gsv.space",
    "GSV_EMAIL_FROM": "noreply@gsv.space",
    "GSV_RP_NAME": "GSV",
    "ENVIRONMENT": "test"
  },
  "d1_databases": [
    {
      "binding": "ACCOUNT_DB",
      "database_name": "gsv-accounts-test",
      "migrations_dir": "migrations"
    }
  ]
}
