{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-accounts",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "accounts.gsv.space/*",
      "zone_name": "gsv.space"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "GSV_ACCOUNT_ORIGIN": "https://accounts.gsv.space",
    "GSV_BASE_DOMAIN": "gsv.space",
    "GSV_EMAIL_FROM": "noreply@gsv.space",
    "GSV_RP_NAME": "GSV",
    "GSV_BILLING_PLAN_KEY": "founding-monthly",
    "GSV_BILLING_CURRENCY": "usd",
    "GSV_BILLING_MONTHLY_PRICE_MINOR": "2000",
    "GSV_BILLING_INFERENCE_BUDGET_MICROUNITS": "5000000",
    "GSV_BILLING_STORAGE_LIMIT_BYTES": "10737418240",
    "GSV_BILLING_PAST_DUE_GRACE_MS": "604800000",
    "GSV_BILLING_RETENTION_MS": "2592000000",
    "ENVIRONMENT": "production"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "GSV_TURNSTILE_SITE_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "GSV_STRIPE_FOUNDING_PRICE_ID",
      "GSV_STRIPE_MERCHANT_MODE"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@gsv.space"]
    }
  ],
  "d1_databases": [
    {
      "binding": "ACCOUNT_DB",
      "database_name": "gsv-accounts",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "GATEWAY",
      "service": "gsv-managed-gateway",
      "entrypoint": "GatewayEntrypoint"
    },
    {
      "binding": "MANAGED_TELEGRAM",
      "service": "gsv-managed-telegram",
      "entrypoint": "ManagedTelegramChannel"
    },
    {
      "binding": "MANAGED_INFERENCE",
      "service": "gsv-inference",
      "entrypoint": "InferenceService"
    }
  ],
  "assets": {
    "directory": "../web/dist-account",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/telegram",
      "/telegram/",
      "/billing",
      "/billing/"
    ]
  },
  "observability": {
    "enabled": true
  }
}
