{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-accounts-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GSV_ACCOUNT_ORIGIN": "http://localhost:8976",
    "GSV_BASE_DOMAIN": "localhost",
    "GSV_INSTALLATION_ORIGIN_TEMPLATE": "http://{handle}.localhost:8976",
    "GSV_EMAIL_FROM": "noreply@gsv.space",
    "GSV_RP_NAME": "GSV local development",
    "GSV_BILLING_PLAN_KEY": "founding-monthly",
    "GSV_BILLING_CURRENCY": "usd",
    "GSV_BILLING_MONTHLY_PRICE_MINOR": "2000",
    "GSV_BILLING_INFERENCE_BUDGET_MICROUNITS": "5000000",
    "GSV_BILLING_STORAGE_LIMIT_BYTES": "10737418240",
    "GSV_BILLING_PAST_DUE_GRACE_MS": "604800000",
    "GSV_BILLING_RETENTION_MS": "2592000000",
    "GSV_OPERATOR_PLAN_KEY": "managed-preview",
    "GSV_OPERATOR_INFERENCE_BUDGET_MICROUNITS": "5000000",
    "GSV_OPERATOR_STORAGE_LIMIT_BYTES": "10737418240",
    "GSV_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "ENVIRONMENT": "development"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@gsv.space"]
    }
  ],
  "d1_databases": [
    {
      "binding": "ACCOUNT_DB",
      "database_name": "gsv-accounts-dev",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "GATEWAY",
      "service": "gsv-managed-gateway-dev",
      "entrypoint": "GatewayEntrypoint"
    },
    {
      "binding": "MANAGED_TELEGRAM",
      "service": "gsv-managed-telegram-dev",
      "entrypoint": "ManagedTelegramChannel"
    },
    {
      "binding": "MANAGED_INFERENCE",
      "service": "gsv-inference-dev",
      "entrypoint": "InferenceService"
    }
  ]
}
