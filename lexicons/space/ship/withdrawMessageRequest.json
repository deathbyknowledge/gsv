{
  "lexicon": 1,
  "id": "space.ship.withdrawMessageRequest",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "The sender withdraws a request it sent. Only its DID finds it.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["requestId"],
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "const": "received"
            }
          }
        }
      }
    }
  }
}
