{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-managed-ripgit",
  "main": "build/index.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "bash ../scripts/worker-build.sh ripgit --release"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORY",
        "class_name": "Repository"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Repository"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
