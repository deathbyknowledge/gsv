{
  "protocol": 5,
  "errors": {
    "bad_request": {
      "retryable": false,
      "meaning": "Arguments failed the catalog schema"
    },
    "unauthorized": {
      "retryable": false,
      "meaning": "Missing or expired token; the SDK refreshes"
    },
    "forbidden": {
      "retryable": false,
      "meaning": "No grant, or a rule denied"
    },
    "approval_denied": {
      "retryable": false,
      "meaning": "An approval was answered no"
    },
    "not_found": {
      "retryable": false,
      "meaning": "No such resource"
    },
    "conflict": {
      "retryable": false,
      "meaning": "Base revision or source changed"
    },
    "moved": {
      "retryable": true,
      "meaning": "The owner moved spaces; re-resolve"
    },
    "target_offline": {
      "retryable": false,
      "meaning": "The machine is offline"
    },
    "outcome_unknown": {
      "retryable": false,
      "meaning": "An effect may or may not have happened"
    },
    "quota_exhausted": {
      "retryable": false,
      "meaning": "Meter and resetsAt in details"
    },
    "rate_limited": {
      "retryable": true,
      "meaning": "With retryAfterMs"
    },
    "storage_full": {
      "retryable": false,
      "meaning": "Volume or quota full"
    },
    "too_large": {
      "retryable": false,
      "meaning": "Over a size limit"
    },
    "timeout": {
      "retryable": "catalog",
      "meaning": "The call's deadline passed"
    },
    "cancelled": {
      "retryable": false,
      "meaning": "Cancelled by its owner"
    },
    "unavailable": {
      "retryable": true,
      "meaning": "A dependency is down"
    },
    "upgrade_required": {
      "retryable": false,
      "meaning": "Client below the minimum version"
    },
    "internal": {
      "retryable": false,
      "meaning": "A bug; ref points at the stored diagnostic"
    }
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "approval_denied",
          "not_found",
          "conflict",
          "moved",
          "target_offline",
