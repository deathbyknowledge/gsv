      "details": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "required": [
      "code",
      "message",
      "retryable"
    ],
    "additionalProperties": false
  },
  "frame": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "const": "req"
          },
          "id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "op": {
            "type": "string"
          },
          "args": {},
          "traceparent": {
            "type": "string"
          }
        },
        "required": [
          "t",
          "id",
          "op",
          "args"
        ]
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "string",
                "const": "res"
              },
              "id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64
              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "result": {}
            },
            "required": [
              "t",
              "id",
              "ok",
              "result"
            ]
          },
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "string",
                "const": "res"
              },
              "id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64
              },
              "ok": {
                "type": "boolean",
                "const": false
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "bad_request",
                      "unauthorized",
                      "forbidden",
                      "approval_denied",
                      "not_found",
                      "conflict",
                      "moved",
                      "target_offline",
                      "outcome_unknown",
                      "quota_exhausted",
                      "rate_limited",
                      "storage_full",
                      "too_large",
                      "timeout",
                      "cancelled",
                      "unavailable",
                      "upgrade_required",
                      "internal"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "retryAfterMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "ref": {
                    "type": "string"
                  },
                  "details": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            },
            "required": [
              "t",
              "id",
              "ok",
              "error"
            ]
          }
        ]
      },
      {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "string",
                "const": "sig"
              },
              "feed": {
                "type": "string",
                "pattern": "^(events|ledger|fs:[^:]+:.+|proc:[^:]+|debug:.+)$"
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "event": {}
            },
            "required": [
              "t",
              "feed",
              "seq",
              "event"
            ]
          },
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "string",
                "const": "sig"
              },
              "feed": {
                "type": "string",
                "pattern": "^(events|ledger|fs:[^:]+:.+|proc:[^:]+|debug:.+)$"
              },
              "head": {
                "type": "string"
              }
            },
            "required": [
              "t",
              "feed",
              "head"
            ]
          }
        ]
      }
    ]
  },
  "operations": {
    "connect": {
      "kind": "owner",
      "verb": "read",
      "effect": "read",
      "errors": [
        "bad_request",
        "unauthorized",
        "moved",
        "upgrade_required",
        "unavailable"
      ],
      "timeoutMs": 10000,
      "secretFields": [],
      "doc": "The first request on a control socket: names the client, resumes cursors and declares watches.",
      "args": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "protocol": {
            "type": "number",
            "const": 5
          },
          "client": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64
              },
              "version": {
                "type": "string",
                "maxLength": 32
              },
              "platform": {
                "type": "string",
                "maxLength": 32
              }
            },
            "required": [
              "name",
              "version",
              "platform"
            ]
          },
          "since": {
            "type": "object",
            "properties": {
              "events": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ledger": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "watches": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(events|ledger|fs:[^:]+:.+|proc:[^:]+|debug:.+)$"
            }
          }
        },
        "required": [
          "protocol",
          "client"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "person": {
            "type": "string"
          },
          "resumed": {
            "anyOf": [
              {
                "type": "boolean",
                "const": true
              },
              {
                "type": "string",
                "const": "reset"
              }
            ]
          },
          "minVersion": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "deprecations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string"
                },
                "until": {
                  "type": "string"
                }
              },
              "required": [
                "op",
                "until"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "owner",
          "person",
          "resumed",
          "minVersion",
          "deprecations"
        ],
        "additionalProperties": false
      }
    }
  }
